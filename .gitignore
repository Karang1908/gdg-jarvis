# Local, per-operator configuration — never commit real tokens
core/config/core.json
core/config/nodes.json
core/config/*.bak
agent/config.json
.env

# Generated from core/config/personality.md by scripts/install-mcp.sh. Two copies that can
# drift is exactly what keeping one source avoids, so the generated one is not tracked.
.agents/

# Runtime state
core/logs/
*.log

# Dedicated browser profiles created by the agent at runtime
.jarvis-overlay-profile/
/tmp/jarvis-*

# Python (MCP server only — agents are dependency-free by design)
__pycache__/
*.pyc
.venv/
venv/

# Node — core is dependency-free, but keep these out if anything is ever added
node_modules/

# OS noise
.DS_Store
Thumbs.db
