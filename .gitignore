# Local, per-operator configuration — never commit real tokens
core/config/core.json
core/config/nodes.json
core/config/*.bak
agent/config.json
.env

# Generated audio. Rebuilt by scripts/warm-voice.sh, and specific to whichever provider
# and voice settings were active — not something to carry between machines.
core/cache/

# .agents/AGENTS.md is tracked on purpose — a pull carries the persona. The MCP config
# beside it is not: it holds the admin password, which must never reach the repository.
.agents/mcp_config.json

# Runtime state
core/logs/
*.log

# Dedicated browser profiles created by the agent at runtime
.jarvis-overlay-profile/
/tmp/jarvis-*

# Python (MCP server only — agents are dependency-free by design)
__pycache__/
*.pyc
.venv/
venv/

# Node — core is dependency-free, but keep these out if anything is ever added
node_modules/

# OS noise
.DS_Store
Thumbs.db
