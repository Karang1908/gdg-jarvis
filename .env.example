# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Anything already exported in your shell wins over what is here — a variable you set
# deliberately should not be overridden by a file you edited three weeks ago.

# ---------------------------------------------------------------------------------------
# JARVIS's voice
# ---------------------------------------------------------------------------------------

# Gemini TTS. Free tier — get a key at https://aistudio.google.com/apikey
# This is the most natural voice available and the one to use if you have any internet.
GEMINI_API_KEY=

# Which of the 30 Gemini voices. Charon is informative and measured; Kore is firmer.
JARVIS_VOICE=Charon

# How lines are delivered. This is the single biggest lever on how JARVIS sounds — the
# model is told how to say it, not just what to say.
JARVIS_STYLE=Speak calmly and with dry composure, in a refined British accent, unhurried and understated

# How long a live voice call may take before falling back to the local voice, in ms.
# JARVIS speaking a little flatly is better than JARVIS pausing mid-demo.
JARVIS_VOICE_BUDGET_MS=1000

# Force one provider instead of picking the best available: gemini | piper | say | espeak
# JARVIS_VOICE_PROVIDER=gemini

# Local neural voice, no internet at all. pip install piper-tts, download an en_GB .onnx,
# and point this at it. Faster than the cloud and never times out.
# JARVIS_PIPER_MODEL=/opt/piper/en_GB-alan-medium.onnx

# ---------------------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------------------

# Normally read from core/config/core.json. Set here only to override.
# JARVIS_ADMIN_TOKEN=
# JARVIS_JOIN_SECRET=
# JARVIS_CORE_URL=http://127.0.0.1:3000
