# Copy this to .env and edit it. That is the whole setup.
#
#   cp .env.example .env
#
# .env is gitignored, so it never leaves your machine and never arrives with a clone —
# you create it once on each machine that runs Core.
#
# Anything already exported in your shell wins over what is here.

# ---------------------------------------------------------------------------------------
# The two passwords
# ---------------------------------------------------------------------------------------

# What YOU type to control the room, on /control/ and /wall/.
# This is the key to every enrolled laptop. Never give it to a teammate.
JARVIS_ADMIN_PASSWORD=change-me-admin

# What lets a device join. Baked into the line teammates run, so nobody types it.
# Must be different from the password above.
# If this leaks, the worst anyone can do is put JARVIS on their own screen.
JARVIS_JOIN_SECRET=change-me-join

# ---------------------------------------------------------------------------------------
# The Wi-Fi
# ---------------------------------------------------------------------------------------

JARVIS_SSID=JARVIS-NET
JARVIS_WIFI_PASSWORD=gdg@essentials2026

# ---------------------------------------------------------------------------------------
# JARVIS's voice
# ---------------------------------------------------------------------------------------

# Free key at https://aistudio.google.com/apikey — this is the natural-sounding voice.
# Leave it blank and JARVIS falls back to the robotic system voice.
GEMINI_API_KEY=

# Which of the 30 Gemini voices. Charon is measured; Kore is firmer.
JARVIS_VOICE=Charon

# How lines are delivered. The biggest single lever on how JARVIS sounds.
JARVIS_STYLE=Speak calmly and with dry composure, in a refined British accent, unhurried and understated

# How long a voice call may take before giving up and using the local voice, in ms.
# Off by default — Gemini routinely takes longer than a second, and falling back means
# hearing the robotic voice instead of the one you chose.
# JARVIS_VOICE_BUDGET_MS=

# Local neural voice, no internet at all. pip install piper-tts, then point this at an
# en_GB .onnx model. Faster than the cloud and cannot time out.
# JARVIS_PIPER_MODEL=/opt/piper/en_GB-alan-medium.onnx

# ---------------------------------------------------------------------------------------
# What JARVIS hears
#
# The microphone is on THIS machine, not on the phone. The phone's mic button opens and
# closes it remotely.
#
# Two things have to exist here: something to record, and something to transcribe.
#
#   sudo apt install -y sox     records, and stops when you stop talking
#   sudo apt install -y whisper transcribes locally, no network
#
# With no local transcriber, GEMINI_API_KEY above is used instead — the same key as the
# voice, which means the uplink has to be up.
# ---------------------------------------------------------------------------------------

# whisper.cpp is faster than the Python whisper, but needs its model file named outright.
# JARVIS_WHISPER_MODEL=/usr/share/whisper.cpp/models/ggml-base.en.bin

# Which Python whisper model, when that is what is installed. tiny.en is the fast one.
# JARVIS_WHISPER_SIZE=tiny.en

# Which Gemini model transcribes, when nothing local is installed. The default is
# gemini-3.7-flash, which is the model Google's own audio example uses. It must be a model
# that accepts audio input — a text-only or unknown model answers 404.
#
# gemini-3.5-transcribe is a dedicated speech-to-text model and may well be faster, but its
# request shape is not documented on the audio page, so it is not the default. Try it here.
# JARVIS_STT_MODEL=gemini-3.7-flash

# ---------------------------------------------------------------------------------------
# The model
#
# Speaking into the mic sends anything that is not one of the fixed commands to the
# Antigravity CLI, which reasons about it and calls the room's MCP tools.
#
# Register the tools first, or the model will not be able to see the room:
#   scripts/install-mcp.sh
#
# Expect 12-17 seconds per question. The fixed commands - "take the room", "identify two",
# "release the room" - are matched on Core and stay instant.
# ---------------------------------------------------------------------------------------

# JARVIS_AGY_BIN=agy
# JARVIS_AGY_MODEL=
# JARVIS_ASK_TIMEOUT_MS=45000
